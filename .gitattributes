# Files whose exact bytes matter.
#
# The runner hashes and sends the case input verbatim, and the test suites
# compare the deployed workflow expressions byte for byte. With core.autocrlf
# enabled, Git on Windows would otherwise check these out with CRLF endings and
# `sha256sum` on disk would stop matching the recorded payload hash. The runner
# normalises line endings itself (runner/case.py, canonical_text), so a run is
# safe either way. These rules keep the files on disk identical too.
submission/*_input.json                              text eol=lf
submission/*_NOT_SENT.json                           text eol=lf
control-center/src/data/generated/caseInput.json     text eol=lf
tests/escalation_validation/*.json                   text eol=lf
tests/escalation_validation/*.yaml                   text eol=lf
tests/powerfx_gate/*.txt                             text eol=lf
tests/workflow_engine/*.json                         text eol=lf
tests/workflow_engine/workflows/*.yaml               text eol=lf

# Runtime evidence is preserved exactly as the service returned it. Never
# converted, never normalised, never diffed as text.
evidence/runtime/**                                  -text

# Binary deliverables: never line-ending converted on checkout.
*.pdf                                                -text
*.pptx                                               -text
*.mp4                                                -text
*.wav                                                -text
*.png                                                -text
